# ==============================================================================
# Pulang ke Uttara — Hotel Booking Engine Environment Configuration Template
# Salin file ini menjadi '.env' untuk pengembangan lokal. JANGAN komit nilai rahasia nyata.
# ==============================================================================

# Server & App Environment
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# Database & Cache Infrastructure
DATABASE_URL=postgres://postgres:dev@localhost:5432/booking?sslmode=disable
VALKEY_ADDR=localhost:6379
NATS_URL=nats://localhost:4222

# Redis Cloud / Upstash / Remote Redis (Opsional: Jika menggunakan Redis Cloud gratis)
# Cukup isi salah satu: REDIS_URL (rekomendasi) atau VALKEY_ADDR + REDIS_PASSWORD
# Format REDIS_URL: redis://default:<password>@<host>:<port> (atau rediss:// untuk TLS)
REDIS_URL=
REDIS_PASSWORD=

# Booking Lifecycle & TTL Settings
HOLD_TIMEOUT=30m
QUOTE_TTL=15m
IDEMPOTENCY_TTL=24h
FAKE_PAY_BASE_URL=http://localhost:18080

# Payment Gateway (Xendit) — Wajib diisi jika APP_ENV=production
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Transactional Email (Resend)
RESEND_BASE_URL=https://api.resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pulang ke Uttara <reservations@pulangkeuttara.com>

# Modular WhatsApp Notifier (Pilihan: "log", "generic_http", "twilio", "meta_cloud")
WHATSAPP_PROVIDER=log
WHATSAPP_API_KEY=
WHATSAPP_BASE_URL=
WHATSAPP_ACCOUNT_SID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FROM_PHONE=+6281234567890

# Security: Reverse Proxy & CORS
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
